{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "client.tsx", "scripts/**/*.ts", "test/**/*.ts"]
}
